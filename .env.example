# Bu dosyayı ".env" adıyla kopyala ve doldur.

# Yayını açacağın TikTok kullanıcı adı (@ olmadan). Boş bırakırsan DEMO modunda çalışır.
TIKTOK_USERNAME=

# Sunucu portu (yayın ekranı: http://localhost:3000)
PORT=3000

# Tur süresi (dakika). Tur bitince en çok puanı alan takım şampiyon olur, kupa alır, puanlar sıfırlanır.
# 0 yazarsan tur hiç bitmez, puanlar sürekli birikir.
ROUND_MINUTES=60
CHAMPION_SECONDS=15

# Puanlar
POINTS_PER_COIN=100
POINTS_PER_LIKE=1
POINTS_PER_FOLLOW=50
POINTS_PER_SHARE=50
POINTS_PER_JOIN=10

# (İsteğe bağlı) Euler Stream API anahtarı. TikTok bağlantısı ücretsiz imza sunucusu üzerinden yapılır;
# 7/24 yayında limitlere takılmamak için https://www.eulerstream.com adresinden anahtar alıp buraya yaz.
EULER_API_KEY=

# (İsteğe bağlı) Yönetim paneline şifre koymak için. Doluysa panel: /admin.html?token=ŞİFRE
ADMIN_TOKEN=

# Demo hızını artırmak için (sadece demo modunda)
DEMO_SPEED=1
